# ========================================================
# BAZAAR MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env.local and populate with your Supabase project keys

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Production Site URL (Used for Canonical URLs, OpenGraph, and Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
